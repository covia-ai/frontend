{
  "compilerOptions": {
    "target": "ES2022",  // Changed from es2017
    "lib": ["dom", "dom.iterable", "ES2022"],  // Changed from esnext
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Next 16 requires the automatic runtime here (it rewrites "preserve").
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      // Shared test doubles; mirrors the moduleNameMapper entry in jest.config.js.
      "@test/*": ["./__tests__/support/*"]
    }
  },
  // Next 16 writes dev-server route types under .next/dev/types.
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules"]
}
